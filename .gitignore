web/.env*.local
web/npm-debug.log*
web/yarn-debug.log*
web/yarn-error.log*
web/.vercel

# 💻 IDE & OS Metadata
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
